{
  "name": "stacki",
  "version": "1.0.22",
  "private": true,
  "description": "Stacki Studio, the hosted visual Astro builder: the fork that emdash-stacki deploys.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "node tools/check.mts",
    "lint": "node tools/check.mts lint",
    "typecheck": "node tools/check.mts types",
    "format": "prettier --write .",
    "build": "pnpm --filter @stacki/studio build",
    "dev": "pnpm --filter @stacki/studio dev",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "3.9.9"
  }
}
