{
  "name": "@stacki/studio",
  "version": "1.1.9",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "assemble": "tsx scripts/assemble.ts",
    "build": "tsx scripts/assemble.ts && tsx scripts/build.ts",
    "dev": "pnpm run build && node dist/cli.mjs dev dev-site --background",
    "check": "tsx scripts/assemble.ts && node node_modules/@typescript/native/bin/tsc -p tsconfig.app.json && node node_modules/@typescript/native/bin/tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@cloudflare/containers": "^0.3.7",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/javascript": "^1.5.6",
    "@sanity/icons": "5.2.1",
    "@shikijs/core": "^4.6.0",
    "@shikijs/engine-javascript": "^4.6.0",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "@uiw/react-codemirror": "^4.25.12",
    "codemirror": "^6.0.2",
    "json5": "^2.2.3",
    "jsonc-parser": "^3.3.1",
    "known-css-properties": "^0.37.0",
    "postcss": "^8.5.30",
    "postcss-selector-parser": "^7.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smol-toml": "^1.9.1",
    "typescript": "^5.9.3",
    "ws": "^8.18.0",
    "y-indexeddb": "^9.0.12",
    "yaml": "^2.9.1",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/iosevka": "^5.3.0",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.0",
    "@typescript-eslint/utils": "^8.72.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "astro": "^7.3.8",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "description": "A collaborative, source-preserving visual CMS for Astro",
  "bin": {
    "astro-studio": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/server/integration.ts",
      "import": "./dist/integration.mjs"
    },
    "./bake": {
      "types": "./src/features/bake/bakeSite.ts",
      "import": "./dist/bake.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "vendor",
    "cloudflare/wrangler.jsonc",
    "Dockerfile",
    ".dockerignore",
    "tsconfig.json",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  }
}
